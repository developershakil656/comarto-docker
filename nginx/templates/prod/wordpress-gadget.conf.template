server {
    listen 80;
    server_name gadget.${APP_DOMAIN};
    
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name gadget.${APP_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/gadget.${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gadget.${APP_DOMAIN}/privkey.pem;

    root /var/www/html;
    index index.php index.html;

    client_max_body_size 64M;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_pass wordpress-gadget:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~* /wp-admin/admin-ajax\.php$ {
        fastcgi_pass wordpress-gadget:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }
}
